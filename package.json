{
  "name": "tiktokmoney",
  "version": "0.26.0",
  "private": true,
  "description": "Autonomous short-form video engine for trend discovery, AI generation, quality control, TikTok publishing, analytics and closed-loop learning.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "generate": "node --env-file-if-exists=.env src/cli.js generate",
    "resume": "node --env-file-if-exists=.env src/cli.js resume",
    "opportunities": "node --env-file-if-exists=.env src/cli.js opportunities",
    "test": "node --test",
    "check": "node --check src/cli.js && node --check src/server.js && node --check scripts/setup-pose-sidecar.mjs && node --test",
    "plan": "node --env-file-if-exists=.env src/cli.js plan",
    "run-plan": "node --env-file-if-exists=.env src/cli.js run-plan",
    "setup:pose": "node scripts/setup-pose-sidecar.mjs",
    "motion-library:build": "node --env-file-if-exists=.env src/cli.js motion-library-build",
    "motion-library:list": "node --env-file-if-exists=.env src/cli.js motion-library",
    "benchmark:real": "node --env-file-if-exists=.env src/cli.js benchmark-real",
    "benchmark:summary": "node --env-file-if-exists=.env src/cli.js benchmark-summary"
  },
  "keywords": [
    "ai-video",
    "tiktok",
    "short-form-video",
    "video-generation",
    "generative-ai",
    "content-automation",
    "social-media-automation",
    "content-creation",
    "ai-agents",
    "text-to-video",
    "video-editing",
    "ffmpeg",
    "tiktok-api",
    "content-pipeline",
    "audiovisual",
    "llm",
    "openrouter",
    "runway",
    "luma-ai",
    "elevenlabs"
  ]
}
