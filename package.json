{
  "name": "tiktokmoney",
  "version": "0.24.0",
  "private": true,
  "description": "Prototype autonomous short-form video engine: trend scoring, creative generation, scene planning and FFmpeg rendering.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "generate": "node --env-file-if-exists=.env src/cli.js generate",
    "opportunities": "node --env-file-if-exists=.env src/cli.js opportunities",
    "test": "node --test",
    "check": "node --check src/cli.js && node --check src/server.js && node --check scripts/setup-pose-sidecar.mjs && node --test",
    "plan": "node --env-file-if-exists=.env src/cli.js plan",
    "run-plan": "node --env-file-if-exists=.env src/cli.js run-plan",
    "setup:pose": "node scripts/setup-pose-sidecar.mjs",
    "motion-library:build": "node --env-file-if-exists=.env src/cli.js motion-library-build",
    "motion-library:list": "node --env-file-if-exists=.env src/cli.js motion-library"
  }
}
