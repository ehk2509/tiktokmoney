PORT=3000
OUTPUT_DIR=./outputs
DATA_DIR=./data
ASSET_DIR=./outputs/assets
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# Pipeline mode: scene-composer | audiovisual
VIDEO_PIPELINE_MODE=scene-composer

# Script generation
LLM_PROVIDER=template
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Live trend intelligence
TREND_REGION=US
TREND_LOOKBACK_HOURS=24
TREND_HISTORY_PATH=./data/trend-history.json
TREND_CLUSTER_THRESHOLD=0.52
TREND_MAX_SIGNALS=120

# YouTube Data API
YOUTUBE_API_KEY=
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_TREND_MAX_RESULTS=25

# Reddit official OAuth API
REDDIT_ACCESS_TOKEN=
REDDIT_API_BASE_URL=https://oauth.reddit.com
REDDIT_USER_AGENT=tiktokmoney/0.16 trend-intelligence
REDDIT_TREND_SUBREDDIT=all
REDDIT_TREND_MAX_RESULTS=40

# Configurable RSS / Atom sources.
# JSON array of URLs or objects: [{"name":"tech","url":"https://example.com/feed.xml"}]
TREND_RSS_FEEDS=
RSS_TREND_MAX_ITEMS=25

# Autonomous daily content planning
DAILY_PLAN_PATH=./data/daily-plans.json
DAILY_CONTENT_BUDGET_USD=6
DAILY_CONTENT_MAX_VIDEOS=3
DAILY_CONTENT_MIN_OPPORTUNITY_SCORE=52
DAILY_CONTENT_MIN_EVIDENCE=1
# Planning estimate used for slot allocation; not an actual billing ledger.
DAILY_CONTENT_ESTIMATED_VIDEO_COST_USD=1.5
DAILY_CONTENT_TOPIC_COOLDOWN_DAYS=7
DAILY_CONTENT_TOPIC_SIMILARITY=0.52
DAILY_CONTENT_HIGH_CONVICTION_SCORE=78
DAILY_CONTENT_HIGH_CONVICTION_ACCELERATION=62
DAILY_CONTENT_MAX_VIDEOS_PER_OPPORTUNITY=2

# Pre-production creative tournament
CREATIVE_TOURNAMENT_ENABLED=true
CREATIVE_TOURNAMENT_CANDIDATES=5
CREATIVE_TOURNAMENT_MIN_WINNER_SCORE=68
CREATIVE_TOURNAMENT_MIN_MARGIN=2
# Optional separate independent judge model; defaults to LLM_MODEL.
CREATIVE_JUDGE_MODEL=

# Current Luma Agents API (preferred Luma integration)
LUMA_AGENTS_API_KEY=
LUMA_AGENTS_BASE_URL=https://agents.lumalabs.ai/v1
LUMA_AGENTS_VIDEO_MODEL=ray-3.2
LUMA_AGENTS_IMAGE_MODEL=uni-1
LUMA_AGENTS_VIDEO_RESOLUTION=720p
LUMA_AGENTS_VIDEO_DURATION=5s
LUMA_AGENTS_POLL_INTERVAL_MS=2500
LUMA_AGENTS_MAX_POLLS=120

# Runway Dev. Gen-4.5 is quality-first; Gen-4 Turbo is a cheaper candidate.
RUNWAYML_API_SECRET=
RUNWAY_BASE_URL=https://api.dev.runwayml.com/v1
RUNWAY_PRIMARY_MODEL=gen4.5
RUNWAY_ENABLE_TURBO=true
RUNWAY_IMAGE_MODEL=gen4_image
RUNWAY_VIDEO_RATIO=720:1280
RUNWAY_IMAGE_RATIO=720:1280
RUNWAY_VIDEO_DURATION=5
RUNWAY_POLL_INTERVAL_MS=2500
RUNWAY_MAX_POLLS=120

# Anti-plastic realism direction + bounded optical post
ANTI_PLASTIC_REALISM_ENABLED=true
REALISM_CAPTURE_PROFILE=auto
REALISM_MAX_SHOTS_PER_ACT=3
ANTI_PLASTIC_POST_ENABLED=true
ANTI_PLASTIC_SOFTNESS_MAX_SIGMA=0.35
ANTI_PLASTIC_GRAIN_MAX_STRENGTH=2.2

# Bundled pose/skeleton extraction and deterministic motion QC.
# Run "npm run setup:pose" locally. Docker installs the sidecar automatically.
# Leave POSE_MOTION_QC_ENABLED unset to auto-enable when a sidecar is discovered.
# POSE_MOTION_QC_ENABLED=
# Optional override for a custom extractor; otherwise .venv-pose / Docker sidecar is auto-detected.
POSE_EXTRACTOR_COMMAND=
# External-command contract. Bundled sidecar args are selected automatically.
# Supported placeholders: {video}, {output_json}, {fps}, {duration}, {model}
POSE_EXTRACTOR_ARGS=
POSE_EXTRACTOR_FPS=8
POSE_EXTRACTOR_TIMEOUT_MS=120000
POSE_MODEL_PATH=./models/pose_landmarker_full.task
POSE_CACHE_DIR=./data/pose-cache
POSE_MOTION_QC_THRESHOLD=78
POSE_MOTION_QC_MIN_COVERAGE=0.55
POSE_MOTION_QC_MAX_REGENERATIONS=1
POSE_MOTION_QC_FAIL_CLOSED=true

# Automatic owned/licensed motion-library builder
MOTION_LIBRARY_ASSET_DIR=./data/motion-library
MOTION_LIBRARY_MIN_SEGMENT_SECONDS=2.5
MOTION_LIBRARY_MAX_SEGMENT_SECONDS=12
MOTION_LIBRARY_MAX_SEGMENTS_PER_CLIP=4
MOTION_LIBRARY_MIN_QUALITY_SCORE=62
MOTION_LIBRARY_DEDUPE_THRESHOLD=0.90
MOTION_LIBRARY_ALLOW_GENERAL=false
# Local clips are transcoded below this raw-byte ceiling so base64 stays under Runway's 5MB data-URI limit.
MOTION_GUIDE_MAX_DATA_URI_BYTES=3600000

# Real-human motion video guidance
MOTION_GUIDE_ENABLED=true
# auto | always | off
MOTION_GUIDE_MODE=auto
MOTION_REFERENCE_LIBRARY_PATH=./data/motion-references.json
MOTION_GUIDE_MIN_RISK_SCORE=50
MOTION_GUIDE_MIN_SELECTION_SCORE=0.55
MOTION_GUIDE_MAX_REFERENCE_SECONDS=15
MOTION_GUIDE_REQUIRE_RIGHTS_CONFIRMED=true
# If the selected guide cannot be downloaded/read, generate without it.
MOTION_GUIDE_FAIL_OPEN=true

# Semantic motion-region control
MOTION_REGION_CONTROL_ENABLED=true
# semantic | off
MOTION_REGION_MODE=semantic
MOTION_REGION_BACKGROUND_LOCK=true
MOTION_REGION_FACE_LOCK=true

# Adaptive first/last-frame control for WAN audiovisual generation
FIRST_LAST_FRAME_ENABLED=true
# auto | first | first-last | off
KEYFRAME_MODE=auto
KEYFRAME_FIRST_RISK_THRESHOLD=32
KEYFRAME_LAST_RISK_THRESHOLD=50
KEYFRAME_IMAGE_RATIO=720:1280
# WAN keyframe mode follows the input frame aspect ratio.
KEYFRAME_VIDEO_RATIO=auto_720p
# If image/keyframe generation fails, fall back to the normal text-to-video path.
KEYFRAME_FAIL_OPEN=true

# Audiovisual Director
# Uses WAN 3 native audio. "locked" first generates exact dialogue with Runway TTS
# and passes it to WAN as an audio reference; "native" asks WAN to generate speech itself.
AUDIOVISUAL_VIDEO_MODEL=wan3
AUDIOVISUAL_VIDEO_RATIO=720:1280
AUDIOVISUAL_DIALOGUE_MODE=locked
AUDIOVISUAL_TTS_MODEL=eleven_v3
AUDIOVISUAL_DEFAULT_VOICE=Bernard

# Multi-speaker locked-dialogue composition
MULTISPEAKER_TURN_GAP_SECONDS=0.16
MULTISPEAKER_MAX_DATA_URI_BYTES=15500000

# Off-screen voiceover uses exact TTS as the authoritative soundtrack.
# Keep model-generated act audio muted by default because it can contain faint
# duplicate speech, echo-like vocals or repeating sound effects.
VOICEOVER_GENERATED_AMBIENCE_GAIN=0

# Dialogue fidelity QC
# In audiovisual mode these auto-enable when the required keys are present.
DIALOGUE_QC_ENABLED=true
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_MODEL=gpt-transcribe
DIALOGUE_QC_MAX_WER=0.12
DIALOGUE_QC_MAX_WORD_COUNT_DELTA=0.12
DIALOGUE_QC_MAX_REGENERATIONS=1

# Visual speech-timing / lip-sync proxy QC
LIPSYNC_QC_ENABLED=true
LIPSYNC_QC_MODEL=
LIPSYNC_QC_THRESHOLD=80
LIPSYNC_QC_FRAMES=10
LIPSYNC_QC_FRAME_WIDTH=384
LIPSYNC_QC_MAX_REGENERATIONS=2

# Multi-speaker attribution / turn-taking QC through OpenRouter
SPEAKER_TURN_QC_ENABLED=true
SPEAKER_TURN_QC_MODEL=
SPEAKER_TURN_QC_THRESHOLD=82
SPEAKER_TURN_QC_FRAME_WIDTH=448
SPEAKER_TURN_QC_MAX_REGENERATIONS=1

# Generated-text QC: reject acts where the video model rendered labels, captions
# or pseudo-text. Intended labels are drawn afterwards from onScreenLabels.
TEXT_ARTIFACT_QC_ENABLED=true
TEXT_ARTIFACT_QC_MODEL=
TEXT_ARTIFACT_QC_FRAMES=4
TEXT_ARTIFACT_QC_FRAME_WIDTH=640
TEXT_ARTIFACT_QC_MAX_REGENERATIONS=1

# Visual factual-consistency QC: compare generated imagery against the narrated
# factual contract. High-confidence contradictions regenerate; ambiguous/generic
# footage passes without pretending the visual proved the narration.
VISUAL_FACT_QC_ENABLED=true
VISUAL_FACT_QC_MODEL=
# Diagnostic warning threshold only; clips fail only on confident contradictions.
VISUAL_FACT_QC_THRESHOLD=82
VISUAL_FACT_QC_MIN_BLOCKING_CONFIDENCE=0.85
VISUAL_FACT_QC_FRAMES=5
VISUAL_FACT_QC_FRAME_WIDTH=640
VISUAL_FACT_QC_MAX_REGENERATIONS=1

# Editorial shot-variety QC: compare each generated act with the previous accepted
# act and require the planned framing change to be visible on screen.
EDITORIAL_VARIETY_QC_ENABLED=true
EDITORIAL_VARIETY_QC_MODEL=
EDITORIAL_VARIETY_QC_THRESHOLD=80
EDITORIAL_VARIETY_QC_FRAMES=3
EDITORIAL_VARIETY_QC_FRAME_WIDTH=512
EDITORIAL_VARIETY_QC_MAX_REGENERATIONS=2

# Cheap screenplay preflight happens before TTS/video generation.
# If a role/interaction/editing/brand contract is structurally wrong, retry the LLM
# screenplay instead of paying for a bad video generation.
PRODUCTION_SCRIPT_PREFLIGHT_MAX_RETRIES=1
# Final plan mirror runs after realism/keyframe/motion directors and before Story
# Bible reference generation, TTS, or video generation.
PRE_GENERATION_QC_MAX_REWRITES=1
PRE_GENERATION_SEMANTIC_QC_ENABLED=true

# Consolidated fallback verifier for role/interaction adherence, hidden montage or
# ghost transitions, and unauthorized visual brand/logo leakage.
PRODUCTION_INTEGRITY_QC_ENABLED=true
PRODUCTION_INTEGRITY_QC_MODEL=
PRODUCTION_INTEGRITY_QC_THRESHOLD=82
PRODUCTION_INTEGRITY_QC_MIN_BLOCKING_CONFIDENCE=0.85
PRODUCTION_INTEGRITY_QC_FRAMES=10
PRODUCTION_INTEGRITY_QC_FRAME_WIDTH=448
PRODUCTION_INTEGRITY_QC_MAX_REGENERATIONS=1

# Optional learned frame-level A/V sync evaluator (SyncNet-class)
# Auto-enables when DEEP_LIPSYNC_COMMAND is set unless explicitly disabled.
DEEP_LIPSYNC_ENABLED=false
DEEP_LIPSYNC_COMMAND=python3
DEEP_LIPSYNC_ARGS=["scripts/syncnet_qc.py","--video","{video}","--s3fd-weights","weights/sfd_face.pth","--syncnet-weights","weights/syncnet_v2.model","--device","cpu"]
DEEP_LIPSYNC_MAX_OFFSET_MS=80
DEEP_LIPSYNC_MIN_CONFIDENCE=5
DEEP_LIPSYNC_MIN_SEGMENT_PASS_RATE=0.8
DEEP_LIPSYNC_MAX_REGENERATIONS=1
DEEP_LIPSYNC_TIMEOUT_MS=120000
# Optional when a stronger evaluator returns normalized 0..1 scores:
DEEP_LIPSYNC_MIN_PHONEME_ALIGNMENT=
DEEP_LIPSYNC_MIN_VISEME_ALIGNMENT=

# Bundled local phoneme↔viseme mouth-shape verifier
PHONEME_VISEME_ENABLED=false
PHONEME_VISEME_COMMAND=python3
PHONEME_VISEME_ARGS=["scripts/phoneme_viseme_qc.py","--video","{video}","--transcription-json","{transcription_json}"]
PHONEME_VISEME_MIN_PHONEME_ALIGNMENT=0.72
PHONEME_VISEME_MIN_VISEME_ALIGNMENT=0.68
PHONEME_VISEME_MIN_COVERAGE=0.72
PHONEME_VISEME_MAX_REGENERATIONS=1
PHONEME_VISEME_TIMEOUT_MS=120000

# Adaptive video model router
PROVIDER_STATS_PATH=./data/provider-stats.json
VIDEO_ROUTER_COST_WEIGHT=8
VIDEO_ROUTER_HISTORY_WEIGHT=22
VIDEO_ROUTER_SWITCH_ON_QC_FAILURE=true

# Legacy Luma Dream Machine compatibility only.
# Prefer LUMA_AGENTS_API_KEY for new deployments.
LUMA_API_KEY=
LUMA_BASE_URL=https://api.lumalabs.ai/dream-machine/v1
LUMA_VIDEO_MODEL=ray-2
LUMA_IMAGE_MODEL=photon-flash-1
LUMA_VIDEO_RESOLUTION=720p
LUMA_VIDEO_DURATION=5s
LUMA_CONTINUITY_WEIGHT=0.62
LUMA_LOCATION_REFERENCE_WEIGHT=0.82
LUMA_CHARACTER_REFERENCE_COUNT=2
LUMA_POLL_INTERVAL_MS=3000
LUMA_MAX_POLLS=120

# Vision-based realism + temporal QC through OpenRouter.
REALISM_QC_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REALISM_QC_MODEL=google/gemini-3.8-flash
REALISM_QC_THRESHOLD=82
REALISM_QC_TEMPORAL_ENABLED=true
REALISM_QC_TEMPORAL_THRESHOLD=80
REALISM_QC_CONTINUITY_THRESHOLD=85
REALISM_QC_KEYFRAME_THRESHOLD=84
REALISM_QC_MOTION_REGION_THRESHOLD=84
REALISM_QC_MOTION_GUIDE_THRESHOLD=80
REALISM_MAX_REGENERATIONS=1
REALISM_QC_FAIL_CLOSED=true
REALISM_QC_FRAMES=3
REALISM_QC_FRAME_WIDTH=512
REALISM_QC_TEMPORAL_FRAMES=8
REALISM_QC_TEMPORAL_FRAME_WIDTH=384
REALISM_QC_COMPARISON_FRAMES=2
REALISM_QC_COMPARISON_FRAME_WIDTH=384

# Real licensed footage fallback
PEXELS_API_KEY=

# Narration
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Burned-in short-form subtitles
SUBTITLES_ENABLED=true
SUBTITLES_MAX_WORDS=5
SUBTITLES_MAX_CHARS=34
SUBTITLES_FONT=DejaVu Sans
SUBTITLES_FONT_SIZE=64
SUBTITLES_MARGIN_V=335
SUBTITLES_MAX_WIDTH_PX=840
SUBTITLES_MAX_LINES=2

# Final audiovisual audio publishability
PUBLISHABILITY_AUDIO_REQUIRED=true
AUDIO_TARGET_LUFS=-14
AUDIO_TRUE_PEAK_DBTP=-1
AUDIO_TARGET_LRA=7
AUDIO_MIN_LUFS=-45

# TikTok Content Posting API.
# Publishing remains disabled unless the CLI/API caller explicitly confirms each post.
# TIKTOK_ACCESS_TOKEN must be a user access token with video.publish.
# video.list is additionally required for post-performance snapshots.
PUBLICATION_STORE_PATH=./data/publications.json
# Optional imported billing records for providers whose generation responses do not expose cost.
PROVIDER_BILLING_PATH=./data/provider-billing.json
PERFORMANCE_LEARNING_PATH=./data/performance-learning.json
PERFORMANCE_LEARNING_MIN_SAMPLES=2
CREATIVE_LEARNING_MAX_ADJUSTMENT=4
EXPERIMENT_OBSERVATION_WINDOW_HOURS=24
EXPERIMENT_COMPARISON_TOLERANCE_HOURS=3
TIKTOK_API_BASE_URL=https://open.tiktokapis.com
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
