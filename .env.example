PORT=3000
OUTPUT_DIR=./outputs
DATA_DIR=./data
ASSET_DIR=./outputs/assets
FFMPEG_BIN=ffmpeg

# Script generation
# template = zero-key deterministic fallback
# openai-compatible = POST /chat/completions with JSON output
LLM_PROVIDER=template
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Stock video. Leave empty to use generated fallback scene cards.
PEXELS_API_KEY=

# Narration. Both values are required to enable ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Future publishing integrations
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
