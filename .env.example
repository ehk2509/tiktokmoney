PORT=3000
OUTPUT_DIR=./outputs
DATA_DIR=./data
ASSET_DIR=./outputs/assets
FFMPEG_BIN=ffmpeg

# Script generation
LLM_PROVIDER=template
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=

# Realism-first AI video.
# When LUMA_API_KEY is configured, AI video is preferred over stock footage.
LUMA_API_KEY=
LUMA_BASE_URL=https://api.lumalabs.ai/dream-machine/v1
LUMA_VIDEO_MODEL=ray-2
LUMA_IMAGE_MODEL=photon-flash-1
LUMA_VIDEO_RESOLUTION=720p
LUMA_VIDEO_DURATION=5s
LUMA_CONTINUITY_WEIGHT=0.62
LUMA_LOCATION_REFERENCE_WEIGHT=0.82
LUMA_CHARACTER_REFERENCE_COUNT=2
LUMA_POLL_INTERVAL_MS=3000
LUMA_MAX_POLLS=120

# Vision-based realism QC through OpenRouter.
# Disabled by default to avoid surprise inference spend.
REALISM_QC_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
REALISM_QC_MODEL=google/gemini-3.8-flash
REALISM_QC_THRESHOLD=82
REALISM_QC_TEMPORAL_ENABLED=true
REALISM_QC_TEMPORAL_THRESHOLD=80
REALISM_MAX_REGENERATIONS=1
REALISM_QC_FAIL_CLOSED=true
REALISM_QC_FRAMES=3
REALISM_QC_FRAME_WIDTH=512
REALISM_QC_TEMPORAL_FRAMES=8
REALISM_QC_TEMPORAL_FRAME_WIDTH=384

# Real licensed footage fallback when AI video is unavailable, rejected, or QC cannot run.
PEXELS_API_KEY=

# Narration. Both values are required to enable ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Future publishing integrations
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
