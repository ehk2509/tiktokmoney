# Copy to .env and edit COMFYUI_WORKFLOW_PATH to your own ComfyUI API export.
# Local AI inference is independent from any hosted OpenAI/Runway/Luma keys.
AI_RUNTIME=local
VIDEO_PIPELINE_MODE=audiovisual

# Ollama/LM Studio: run a local OpenAI-compatible chat-completions server.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3:8b
LOCAL_CREATIVE_JUDGE_MODEL=qwen3:8b

# ComfyUI: run your installed video+audio workflow (e.g. LTX).
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=./comfyui/workflow-api.json
# For image-to-video graphs using {{FIRST_FRAME}}: choose an initial image OR
# supply a second local ComfyUI image workflow to create it automatically.
# COMFYUI_FIRST_FRAME_WORKFLOW_PATH=./comfyui/first-frame-api.json
# COMFYUI_INITIAL_IMAGE_PATH=./data/references/first.png
COMFYUI_FPS=24
COMFYUI_WIDTH=720
COMFYUI_HEIGHT=1280
COMFYUI_MAX_SEGMENT_SECONDS=15
COMFYUI_POLL_INTERVAL_MS=2000
COMFYUI_TIMEOUT_MS=900000
COMFYUI_REQUIRE_AUDIO=true
# Optional: for silent Wan/other workflows, generate voiceover with local
# OpenAI-compatible TTS (e.g. Kokoro-FastAPI), never with a cloud voice API.
# LOCAL_TTS_BASE_URL=http://127.0.0.1:8880/v1
# LOCAL_TTS_MODEL=kokoro
# LOCAL_TTS_VOICE=af_heart
# LOCAL_TTS_FORMAT=wav

ASSET_DIR=./data/assets
OUTPUT_DIR=./data/output
DATA_DIR=./data

# Local QC (optional; install appropriate models/services first)
REALISM_QC_ENABLED=false
# LOCAL_VISION_MODEL=qwen3-vl:8b
LOCAL_VISION_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_VISION_QC_FRAMES=3
REALISM_QC_THRESHOLD=82
REALISM_MAX_REGENERATIONS=1
LOCAL_TRANSCRIPTION_ENABLED=false
# LOCAL_TRANSCRIPTION_BASE_URL=http://127.0.0.1:8000/v1
LOCAL_TRANSCRIPTION_MODEL=whisper-1

# Additional local QC sidecars can be enabled if installed.
POSE_MOTION_QC_ENABLED=false
DEEP_LIPSYNC_ENABLED=false
PHONEME_VISEME_ENABLED=false

# Avoid any remote trend research during an air-gapped run.
YOUTUBE_API_KEY=
REDDIT_ACCESS_TOKEN=
TREND_RSS_FEEDS=
# Publishing still uses the network, requires separate TikTok OAuth and confirmation.

CREATIVE_TOURNAMENT_ENABLED=false

# Quality settings for local LTX runs (see comfyui/ for example workflows).
# Image workflow for each act's opening still; {{CHARACTER_REFERENCE}} keeps the same person.
# COMFYUI_FIRST_FRAME_WORKFLOW_PATH=./comfyui/first-frame-api.json
# COMFYUI_EMPTY_REFERENCE_IMAGE=ai_shorts_no_reference.png
# Re-render speaking clips whose voice starts late or ends early (silent lip movement).
COMFYUI_MAX_SPEECH_ONSET_SECONDS=0.6
COMFYUI_SPEECH_ONSET_RETRIES=2
# Script quality: fact-check spoken claims, require speech to fill on-camera acts.
SCRIPT_FACT_CHECK_ENABLED=true
SCRIPT_STRICT_SPEECH_TIMING=true
PRODUCTION_SCRIPT_PREFLIGHT_MAX_RETRIES=3
PRE_GENERATION_QC_MAX_REWRITES=2
# Optional lip-sync pass with Wan 2.1 InfiniteTalk (needs its models in ComfyUI).
COMFYUI_INFINITETALK_ENABLED=false
COMFYUI_INFINITETALK_WIDTH=480
COMFYUI_INFINITETALK_HEIGHT=832
COMFYUI_INFINITETALK_STEPS=6

# Saved rooms and camera angles when a video revisits a location with different shots.
# Needs qwen-image-edit-2511-multiple-angles-lora in models/loras, birefnet in
# models/background_removal, COMFYUI_FIRST_FRAME_WORKFLOW_PATH and LOCAL_VISION_MODEL.
COMFYUI_LOCATION_ANGLES=false
# Pause each new location until a candidate is approved with `approve-location`.
COMFYUI_LOCATION_REQUIRE_APPROVAL=false
# COMFYUI_LOCATION_CANDIDATES=4
# COMFYUI_LOCATION_MAX_ROUNDS=2
# COMFYUI_LOCATION_DIR=./data/locations
